# Copy to .env and change the secrets before deploying.
POSTGRES_USER=metering
POSTGRES_PASSWORD=change-me
POSTGRES_DB=metering
INTERNAL_SECRET=change-me-to-a-long-random-string
# Comma-separated emails that get the operator role at signup.
OPERATOR_EMAILS=operator@example.com
# Behind Caddy with TLS: COOKIE_SECURE=true, TRUST_PROXY=true, DOMAIN=your.domain
COOKIE_SECURE=false
TRUST_PROXY=false
DOMAIN=localhost
# 127.0.0.1 keeps the app private (use Caddy in front); 0.0.0.0 exposes port 8000.
APP_BIND=127.0.0.1
